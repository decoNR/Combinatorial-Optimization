\usepackage{mathtools}

% absolute value
% \abs{x}
% \abs[\big]{\sum_{i \in I} x_i}
% \abs*{\sum_{i \in I} x_i}
% taken from mathtools documentation
\DeclarePairedDelimiter\abs{\lvert}{\rvert}

% adjugate matrix
% \adj(A)
\DeclareMathOperator{\adj}{adj}

% function composition
% f \after g
\newcommand*{\after}{\mathbin{\circ}}

% automorphism group
% \Aut(K)
\DeclareMathOperator{\Aut}{Aut}

% cardinality
% \card{S}
% \card[\Bigg]{\bigcup_{i \in I} A_i}
% \card*{\bigcup_{i \in I} A_i} uses \left and \right
\DeclarePairedDelimiter\card{\lvert}{\rvert}

% ceiling
% \ceiling{x}
% \ceiling[\Bigg]{\sum_{i \in I} x_i}
% \ceiling*{\sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiter\ceiling{\lceil}{\rceil}

% closure
% \cl(X)
\DeclareMathOperator{\cl}{cl}

% set of complex numbers
% \complex
\newcommand*{\Complex}{\mathbb{C}}

% function composition
% f \compose g
\newcommand*{\compose}{\after}

% convex hull
% \conv(X)
\DeclareMathOperator{\conv}{conv}

% corank
% \corank(M)
\DeclareMathOperator{\corank}{corank}

% curly braces
% \curly{x}
% \curly[\Bigg]{\sum_{i \in I} x_i}
% \curly*{\sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiter\curly{\{}{\}}

% del
% \frac{\del f}{\del x}
\newcommand*{\del}{\partial}

% delta in
% \deltain(S)
% \deltain[D](S)
\newcommand*{\deltain}[1][]{\delta_{#1}^{\scriptscriptstyle \textrm{in}}}

% delta out
% \deltaout(S)
% \deltaout[D](S)
\newcommand*{\deltaout}[1][]{\delta_{#1}^{\scriptscriptstyle \textrm{out}}}

% diagonal matrix from vector
% \Diag(X)
\DeclareMathOperator{\Diag}{Diag}

% extract diagonal from matrix
% \diag(X)
\DeclareMathOperator{\diag}{diag}

% diameter
% \diam(X)
\DeclareMathOperator{\diam}{diam}

% in degree
% \din(S)
% \din[D](S)
\newcommand*{\din}[1][]{d_{#1}^{\scriptscriptstyle \textrm{in}}}

% distance
% \dist_G(r,s)
\DeclareMathOperator{\dist}{dist}

% out degree
% \dout(S)
% \dout[D](S)
\newcommand*{\dout}[1][]{d_{#1}^{\scriptscriptstyle \textrm{out}}}

% drop
% V \drop S
\newcommand*{\drop}{\setminus}

% the empty set
% \emptyset
\let\oldemptyset\emptyset
\renewcommand*{\emptyset}{\varnothing}

% epsilon
% \eps
\newcommand*{\eps}{\varepsilon}

% function definition
% f \ffrom V \fto \Reals
\newcommand*{\ffrom}{\colon}

% floor
% \floor{x}
% \floor[\Bigg]{\sum_{i \in I} x_i}
% \floor*{\sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor}

% function definition
% f \ffrom V \fto \Reals
\newcommand*{\fto}{\to}

% half-closed interval (open left, closed right)
% \halfclosed{x,y}
\DeclarePairedDelimiter\halfclosed{(}{]}

% half-open interval (closed left, open right)
% \halfopen{x,y}
\DeclarePairedDelimiter\halfopen{[}{)}

% set of Hermitian matrices
% \Her{V}
\newcommand{\Her}[1]{\mathbb{H}^{#1}}

% set of Hermitian matrices that are pd
% \HPd{V}
\newcommand{\Hpd}[1]{\mathbb{H}_{++}^{#1}}

% Hadamard product
% A \hprod B
\newcommand*{\hprod}{\mathbin{\odot}}

% set of Hermitian matrices that are psd
% \HPsd{V}
\newcommand{\Hpsd}[1]{\mathbb{H}_+^{#1}}

% ignore
% \ignore{this will not appear}
\newcommand{\ignore}[1]{}

% imaginary unit (to distinguish it from dummy index i)
% a+\im b
\newcommand*{\im}{\mathrm{i}}

% image/range
% \Image(A)
\DeclareMathOperator{\Image}{Im}

% incidence vector
% \incidv{F}
\newcommand*{\incidv}[1]{\mathbbm{1}_{#1}}

% set of integers
% \Integers
\newcommand*{\Integers}{\mathbb{Z}}

%  interior
\DeclareMathOperator{\interior}{int}

% inner product, <.,.> notation
% \iprod{I}{X}
\DeclarePairedDelimiterXPP{\iprod}[2]{}{\langle}{\rangle}{}{#1,\mathopen{}#2}

% symmetric inner product
% \iprodsym{x}
\DeclarePairedDelimiterXPP{\iprodsym}[1]{}{\langle}{\rangle}{}{#1,\mathopen{}#1}

% inner product, .^T. notation
% \iprodt{x}{y}
\newcommand{\iprodt}[2]{#1^{\transp}#2}

% symmetric inner product, .^T. notation
% \iprodtsym{x}
\newcommand{\iprodtsym}[1]{#1^{\transp}#1}

% Iverson notation
% \Iverson{x > 0}
% \Iverson[\Big]{\sum_{i=1}^n x_i > 0}
% \Iverson*{\sum_{i=1}^n x_i > 0} uses \left and \right
\DeclarePairedDelimiter\Iverson{[}{]}

% decreasing vector of eigenvalues
% \lambdadown(X)
% \lambdadown[1](X)
\newcommand*{\lambdadown}[1][]{\lambda_{#1}^{\downarrow}}

% maximum eigenvalue
% \lambdamax(X)
\newcommand*{\lambdamax}{\lambda_{\max}}

% minimum eigenvalue
% \lambdamin(X)
\newcommand*{\lambdamin}{\lambda_{\min}}

% increasing vector of eigenvalues
% \lambdaup(X)
% \lambdaup[1](X)
\newcommand*{\lambdaup}[1][]{\lambda_{#1}^{\uparrow}}

% lifted theta body
% \liftedTH(G)
\newcommand*{\liftedTH}{\widehat{\THbody}}

% linear span (unfortunately, \span is already defined) == linear hull
% \linspan\set{\ones}
\DeclareMathOperator{\linspan}{span}

% Moore-Penrose pseudoinverse
% X^{\MPinv}
\newcommand*{\MPinv}{\dagger}

% natural numbers
\newcommand{\Naturals}{\mathbb{N}}

% avoids unpleasant line breaks
% $k$\nbd-connected
\newcommand*{\nbd}{\nobreakdash}

% norm
% \norm{x}
% \norm[\Big]{\sum_{i \in I} x_i}
% \norm*{\sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiter\norm{\lVert}{\rVert}

% nullspace
% \Null(A)
\DeclareMathOperator{\Null}{Null}

% Requires: \usepackage{bbm}
% vector of all-ones
\newcommand*{\ones}{\mathbbm{1}}

% outer product, xy^T
% \oprod{x}{y}
\newcommand{\oprod}[2]{#1^{}#2^{\transp}}

% symmetric outer product
% \oprodsym{x}
%
% The ^{} is added after #1 to ensure that indices in \oprod have the
% same vertical alignment; note that #1 is already expected not to
% have any superscripts anyway
\newcommand{\oprodsym}[1]{\oprod{#1}{#1}}

% optimal value
% \opt
\DeclareMathOperator{\opt}{opt}

% parentheses
% \paren{x}
% \paren[\Bigg]{\sum_{i \in I} x_i}
% \paren*{\sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiter\paren{(}{)}

% cone of positive definite matrices
% \Pd{n}
\newcommand*{\Pd}[1]{\mathbb{S}_{++}^{#1}}

% permanent
% \per(A)
\DeclareMathOperator{\per}{per}

% p-norm
% \pnorm{x}{\infty}
% \pnorm[\Big]{\sum_{i \in I} x_i}{\infty}
% \pnorm*{\sum_{i \in I} x_i}{\infty} uses \left and \right
\DeclarePairedDelimiterXPP{\pnorm}[2]{}\lVert\rVert{_{#2}}{#1}

% power set
% \Powerset{V}
\newcommand*{\Powerset}[1]{\mathcal{P}(#1)}

% cone partial order
\let\oldpreceq\preceq
\renewcommand*{\preceq}{\preccurlyeq}

% orthogonal projection onto L
% \Proj_L
\DeclareMathOperator{\Proj}{Proj}

% cone of positive semidefinite matrices
% \Psd{n}
\newcommand*{\Psd}[1]{\mathbb{S}_+^{#1}}

% quadratic form, x^T Q x
% \qform{Q}{x}
\newcommand{\qform}[2]{#2^{\transp}#1#2}

% rank
% \rank(X)
\DeclareMathOperator{\rank}{rank}

% set of rationals
% \Rationals
\newcommand*{\Rationals}{\mathbb{Q}}

% reaches
% r \reaches_D s
\newcommand*{\reaches}{\rightsquigarrow}

% set of reals
% \Reals
\newcommand*{\Reals}{\mathbb{R}}

% function restriction
% f\restrict{S}
\newcommand*{\restrict}[1]{\mathord{\restriction}_{#1}}

% sequence
% \seq{v_1,\dotsc,v_n}
\DeclarePairedDelimiter{\seq}{\langle}{\rangle}

% set curly braces
% \set{1,2,\dotsc,n}
% \set[\Bigg]{\bigcup_{i \in I} A_i}
\DeclarePairedDelimiter\set{\{}{\}}

% set curly braces, with condition separated by colon
% \setst{x \in \Reals^n}{Ax = b}
% \setst[\Bigg]{x \in \Reals^n}{Ax = b,\, x = \sum_{i \in I} x_i}
% \setst*{x \in \Reals^n}{Ax = b,\, x = \sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiterXPP\setst[2]{}\{\}{}{\,#1\,\colon\mathopen{}#2}

% set curly braces, with condition separated by pipe
% \setbar{x \in \Reals^n}{Ax = b}
% \setbar[\Bigg]{x \in \Reals^n}{Ax = b,\, x = \sum_{i \in I} x_i}
% \setbar*{x \in \Reals^n}{Ax = b,\, x = \sum_{i \in I} x_i} uses \left and \right
\DeclarePairedDelimiterXPP\setbar[2]{}\{\}{}{\,#1\nonscript\:\delimsize\vert\nonscript\:\mathopen{}#2}

% sign
% \sign(x)
\DeclareMathOperator{\sign}{sign}

% sign
% \sgn(f)
\DeclareMathOperator{\sgn}{sgn}

% square brackets
% \sqbrac{x}
% \sqbrac[\Bigg]{\sum_{i \in I} x_i}
\DeclarePairedDelimiter\sqbrac{[}{]}

% such that
\newcommand*{\st}{\colon}

% cone partial order
\let\oldsucceq\succeq
\renewcommand*{\succeq}{\succcurlyeq}

% support
% \supp(x)
\DeclareMathOperator{\supp}{supp}

% space of symmetric matrices
% \Sym{n}
\newcommand*{\Sym}[1]{\mathbb{S}^{#1}}

% symmetric difference
% X \symdiff Y
\newcommand*{\symdiff}{\mathbin{\Delta}}

% symmetric group
% \SymGroup{V}
\newcommand*{\SymGroup}[1]{\operatorname{Sym}_{#1}}

% nonnegative symmetric matrices
% \Symnonneg{n}
\newcommand*{\Symnonneg}[1]{\mathbb{S}_{\scriptscriptstyle\geq 0}^{#1}}

% trace
% \trace(X)
\DeclareMathOperator{\trace}{Tr}

% transpose
% X^{\transp}
\newcommand*{\transp}{\mathsf{T}}

% replace vec operator and original \vec command (arrow)
\DeclareMathOperator{\myvec}{vec}
\let\arrowvec\vec
\let\vec\myvec

% volume
% \vol(S)
\DeclareMathOperator{\vol}{vol}
